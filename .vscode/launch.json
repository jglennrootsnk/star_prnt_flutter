    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dart Console: Run Main",
            "request": "launch",
            "type": "dart",
            "program": "bin/main.dart",
            "console": "terminal"
        },
        {
            "name": "Dart Console: Run Raster Demo",
            "request": "launch",
            "type": "dart",
            "program": "example/raster_demo.dart",
            "console": "terminal"
        },
        {
            "name": "Direct Dart: lib/main.dart",
            "request": "launch", 
            "type": "dart",
            "program": "lib/main.dart",
            "console": "terminal",
            "env": {
                "FLUTTER_ROOT": ""
            }
        }
    ]
}