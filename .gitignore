# ── Editor / IDE directories ──
.vscode/
.idea/
**/.idea/
*.iml
*.ipr
*.iws
.claude/

# ── Build outputs ──
build/
**/build/
/build/
example/build/

# ── Plugin native code: Android Gradle artifacts ──
# android/ itself IS tracked — it contains the plugin's Kotlin source and
# build.gradle. Only ignore generated/machine-specific files inside it.
android/.gradle/
android/build/
android/local.properties
android/captures/
android/.cxx/
android/.idea/

# ── Plugin native code: iOS CocoaPods artifacts ──
# ios/ itself IS tracked — it contains the plugin's Swift source, podspec,
# and Star's vendored Frameworks/. Only ignore install artifacts.
ios/.symlinks/
ios/Pods/
ios/Podfile.lock

# ── Generated Flutter platform scaffolding inside example/ ──
# These are regenerated by `flutter create` and contain machine-specific paths.
example/.dart_tool/
example/.flutter-plugins-dependencies
example/android/.gradle/
example/android/.idea/
example/android/local.properties
example/ios/Flutter/Flutter.framework
example/ios/Flutter/Flutter.podspec
example/ios/Flutter/Generated.xcconfig
example/ios/Flutter/app.flx
example/ios/Flutter/app.zip
example/ios/Flutter/flutter_assets/
example/ios/Flutter/flutter_export_environment.sh
example/ios/ServiceDefinitions.json
example/ios/Runner/GeneratedPluginRegistrant.*
example/ios/Pods/
example/ios/Podfile.lock
example/macos/Pods/
example/macos/Podfile.lock
example/macos/Flutter/GeneratedPluginRegistrant.swift
example/macos/Flutter/ephemeral/
example/linux/flutter/ephemeral/
example/windows/flutter/ephemeral/
macos/

# ── Symbolication / obfuscation artifacts ──
app.*.symbols
app.*.map.json

# ── Local demo / preview output ──
raster-previews/
label-output/

# ── Logs and misc ──
*.log
*.pyc
*.class
*.swp

# ── Package convention: lockfile is consumer-resolved for libraries ──
pubspec.lock

# ── Vendored reference docs (kept locally, not in repo) ──
starPRNT_cm_en_Rev3.80.pdf
