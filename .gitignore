# ── macOS / OS metadata ──
.DS_Store
**/.DS_Store
Thumbs.db

# ── Hidden tool / cache directories ──
.dart_tool/
**/.dart_tool/
.pub/
.pub-cache/
.packages
.flutter-plugins
.flutter-plugins-dependencies
**/.flutter-plugins
**/.flutter-plugins-dependencies
.atom/
.buildlog/
.history
.svn/
